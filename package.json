{
  "name": "lensforge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Physically rigorous real-time Kerr black hole renderer for the browser (WebGPU).",
  "license": "MIT",
  "keywords": [
    "black-hole",
    "kerr-metric",
    "general-relativity",
    "gravitational-lensing",
    "ray-tracing",
    "webgpu",
    "wgsl",
    "scientific-visualization"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tools:flux-lut": "tsx tools/generateNtFluxLut.ts",
    "tools:planck-lut": "tsx tools/generatePlanckXyzLut.ts",
    "tools:fetch-sky": "tsx tools/fetchSkySources.ts",
    "tools:sky": "tsx tools/generateSkyAssets.ts",
    "tools:figures": "tsx tools/generateFigures.ts"
  },
  "devDependencies": {
    "@tweakpane/core": "^2.0.5",
    "@types/node": "^26.1.1",
    "@webgpu/types": "^0.1.44",
    "parse-exr": "^1.0.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "ktx-parse": "^1.1.0",
    "tweakpane": "^4.0.5"
  }
}
